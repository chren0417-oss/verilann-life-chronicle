# Copy to .env for local development. Never commit a real API key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# For Alibaba Cloud Bailian, set AI_PROVIDER=bailian and use its own key.
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
# Enable free-quota-only for this model in Bailian before free-only use.
